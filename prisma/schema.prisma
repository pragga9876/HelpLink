generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  name           String
  role           String    @default("VOLUNTEER") // REPORTER or VOLUNTEER
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  reports        Report[]
  microTasks     MicroTask[]
  volunteerProfile VolunteerProfile?
}

model VolunteerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            String   // Comma-separated skills
  preferredLocation String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Report {
  id          String    @id @default(cuid())
  problemType String    // MEDICAL, FOOD, EDUCATION, SHELTER, SANITATION, OTHER
  location    String
  description String
  severity    String    // LOW, MEDIUM, HIGH
  contactInfo String?
  priorityScore Int     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reporterId  String
  reporter    User      @relation(fields: [reporterId], references: [id])
  
  microTasks  MicroTask[]
}

model MicroTask {
  id          String      @id @default(cuid())
  title       String
  description String
  status      String      @default("AVAILABLE") // AVAILABLE, CLAIMED, IN_PROGRESS, COMPLETED
  location    String
  reportId    String
  report      Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  volunteerId String?
  volunteer   User?       @relation(fields: [volunteerId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}